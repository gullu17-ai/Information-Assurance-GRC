# Set these in the VS Code terminal before launching Streamlit for optional external mode.
# The app reads the process environment. This file documents the variables.
# Use a vetted HTTPS chat-completions endpoint and synthetic/non-sensitive inputs.
PASS_LLM_URL=
PASS_LLM_MODEL=
PASS_LLM_API_KEY=
# Optional path to a separate local SQLite file.
PASS_DB_PATH=
